<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Only for xtool (xtool.yml), which merges these keys over its own defaults.
  Xcode generates its Info.plist from project.yml's INFOPLIST_KEY_* settings
  and Krowk-Info.plist; keep them in step. No ITSAppUsesNonExemptEncryption:
  that answer is the person's (README.md → Export compliance).
-->
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>krowk</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<!-- As Xcode's UIApplicationSceneManifest_Generation writes it. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- ProMotion: the transcript's display link may run above 60 Hz. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>krowk uses the camera to scan the pairing code another device shows.</string>
	<!-- Face ID before an allow from the phone runs a command (R-IOS-11). -->
	<key>NSFaceIDUsageDescription</key>
	<string>Confirm it's you before krowk runs a command on your computer.</string>
	<!-- Racing a session's LAN address (R-NET-2). -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>krowk connects straight to your computer when it's on the same network.</string>
</dict>
</plist>
