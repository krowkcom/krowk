#!/bin/bash
# A stand-in for OpenAI's `codex` binary, so no test needs a real login. It
# speaks what krowk drives: `login`, `login status` and `logout` against a
# marker file in CODEX_HOME (never Codex's own login file), and `app-server`
# — JSON-RPC over stdio, one object per line — replaying a recorded
# scenario turn by turn. The messages are the ones a real `codex app-server`
# 0.154.0 sent (`recorded/`), trimmed; the tests validate every one against
# the pinned schema.
#
# Written for the bash macOS ships (3.2): no associative arrays, no
# fractional `read -t`. It reads krowk's lines by their leading `{"id":N,
# "method":"…"`, which is how krowk writes them.
#
# Environment:
#   FAKE_CODEX_SCENARIO  the scenario file (below); a plain answer without one
#   FAKE_CODEX_LOG       where every argv, CODEX_HOME and line in or out is appended
#   FAKE_CODEX_THREAD    the id of a new thread
#   FAKE_CODEX_LOGIN     `fail`: `codex login` gives up, as a person closing the browser would
#   FAKE_CODEX_SANDBOX   the sandbox thread/start reports, as a managed config could force it
#   FAKE_CODEX_REVIEWER  the approvals reviewer it reports, the same way
#   FAKE_CODEX_RESUME    `fail`: thread/resume finds no such thread; it also
#                        fails, as Codex does, when the thread's rollout (the
#                        `path` it is given, else the one under CODEX_HOME,
#                        where each turn/start is appended) is not there
#   FAKE_CODEX_MCP       the `mcp_servers` table config/read reports, as JSON
#
# A `-c hooks.PreToolUse=…` naming `__paste-guard` is listed by hooks/list
# as krowk's paste guard, untrusted until config/value/write trusts it (a
# marker in CODEX_HOME), as Codex keeps a hook's trust in its config.
#
# The marker `fake-login` holds the account: `chatgpt <email>` or `apiKey`.
# A scenario is turns separated by lines holding `---`; each turn/start
# plays the next turn (counted in CODEX_HOME, so across processes). Each
# line of a turn:
#   a JSON line        printed, with {{THREAD}}, {{TURN}}, {{MODEL}}, {{CWD}} filled in
#   @ask <request>     sent as a server request; waits for krowk's answer
#   @tool-result <id>  a dynamicToolCall item/completed for <id>, carrying
#                      the text of the last answer
#   @await-interrupt   waits for krowk's turn/interrupt, and answers it
#   @await-steer       waits for krowk's turn/steer, and takes it
#   @refuse-steer      waits for krowk's turn/steer, and refuses it (the turn is ending)
#   @sleep <seconds>   waits
#   @exit <code>       exits mid-turn, as a crashed process would
#   @exit-once <code>  the same, the first time only (a marker in CODEX_HOME)
#   @grandchild        starts a background `sleep`, as a command Codex ran
#                      would, and logs its pid
# The turn ends with the scenario's own turn/completed line.

set -u
LOG="${FAKE_CODEX_LOG:-/dev/null}"
HOME_DIR="${CODEX_HOME:-$HOME/.codex}"
log() { printf '%s\n' "$*" >>"$LOG"; }
log "argv $*"
ARGV="$*"
log "home ${CODEX_HOME:-<unset>}"
log "pid $$"
log "env OPENAI_API_KEY=${OPENAI_API_KEY:-<unset>} ROUTER_KEY=${ROUTER_KEY:-<unset>}"

case "${1:-}" in
--version)
  echo "codex-cli 0.154.0"
  exit 0
  ;;
logout)
  rm -f "$HOME_DIR/fake-login"
  echo "Successfully logged out"
  exit 0
  ;;
login)
  if [ "${2:-}" = status ]; then
    if [ -f "$HOME_DIR/fake-login" ]; then
      case "$(cat "$HOME_DIR/fake-login")" in
      apiKey*) echo "Logged in using an API key - sk-proj-***FAKE" >&2 ;;
      *) echo "Logged in using ChatGPT" >&2 ;;
      esac
      exit 0
    fi
    echo "Not logged in" >&2
    exit 1
  fi
  if [ "${FAKE_CODEX_LOGIN:-}" = fail ]; then
    echo "Login cancelled." >&2
    exit 1
  fi
  mkdir -p "$HOME_DIR" && printf 'chatgpt %s\n' "${FAKE_CODEX_EMAIL:-person@example.com}" >"$HOME_DIR/fake-login"
  echo "Successfully logged in"
  exit 0
  ;;
app-server) ;;
*)
  echo "fake-codex: unknown command ${1:-}" >&2
  exit 2
  ;;
esac

THREAD="${FAKE_CODEX_THREAD:-01a0d8df-ba17-70c0-b9b6-9049bdb7a89c}"
TURN=""
MODEL="gpt-5.5"
CWD="$PWD"
SRV=0
LAST=""

say() {
  log "out $1"
  printf '%s\n' "$1"
}

# The id and method of a request krowk sent, or empty.
req_id() { printf '%s' "$1" | sed -n 's/^{"id":\([0-9]*\),"method":.*/\1/p'; }
req_method() { printf '%s' "$1" | sed -n 's/^{"id":[0-9]*,"method":"\([^"]*\)".*/\1/p'; }
field() { printf '%s' "$1" | sed -n "s/.*\"$2\":\"\\([^\"]*\\)\".*/\\1/p" | head -n 1; }

fill() {
  local l="$1"
  l="${l//\{\{THREAD\}\}/$THREAD}"
  l="${l//\{\{TURN\}\}/$TURN}"
  l="${l//\{\{MODEL\}\}/$MODEL}"
  l="${l//\{\{CWD\}\}/$CWD}"
  printf '%s' "$l"
}

account() {
  if [ -f "$HOME_DIR/fake-login" ]; then
    case "$(cat "$HOME_DIR/fake-login")" in
    apiKey*) printf '{"account":{"type":"apiKey"},"requiresOpenaiAuth":true}' ;;
    *) printf '{"account":{"type":"chatgpt","email":"%s","planType":"plus"},"requiresOpenaiAuth":true}' "$(cut -d' ' -f2 <"$HOME_DIR/fake-login")" ;;
    esac
  elif [ -n "${ROUTER_KEY:-}" ]; then
    printf '{"account":null,"requiresOpenaiAuth":false}'
  else
    printf '{"account":null,"requiresOpenaiAuth":true}'
  fi
}

rollout_path() { printf '%s' "$HOME_DIR/sessions/2026/09/25/rollout-2026-09-25T12-00-00-$THREAD.jsonl"; }

thread_result() {
  local sandbox="$1" approval="$2" reviewer="$3"
  local path
  path="$(rollout_path)"
  mkdir -p "$(dirname "$path")" && : >>"$path"
  local kind
  case "$sandbox" in
  read-only) kind=readOnly ;;
  workspace-write) kind=workspaceWrite ;;
  danger-full-access) kind=dangerFullAccess ;;
  *) kind="$sandbox" ;;
  esac
  kind="${FAKE_CODEX_SANDBOX:-$kind}"
  reviewer="${FAKE_CODEX_REVIEWER:-$reviewer}"
  printf '{"thread":{"id":"%s","sessionId":"%s","preview":"","projectId":null,"ephemeral":false,"modelProvider":"openai","model":"%s","createdAt":1790344936,"updatedAt":1790344936,"status":{"type":"idle"},"path":"%s","cwd":"%s","cliVersion":"0.154.0","source":"appServer","turns":[]},"model":"%s","modelProvider":"openai","serviceTier":null,"cwd":"%s","instructionSources":[],"approvalPolicy":"%s","approvalsReviewer":"%s","sandbox":{"type":"%s","networkAccess":false},"reasoningEffort":null}' \
    "$THREAD" "$THREAD" "$MODEL" "$path" "$CWD" "$MODEL" "$CWD" "$approval" "$reviewer" "$kind"
}

# A request krowk sent while the scenario waits on something else: steering
# and interrupts are taken as a running turn takes them.
side_request() {
  local line="$1" id method
  id="$(req_id "$line")"
  method="$(req_method "$line")"
  case "$method" in
  turn/steer)
    log "steer $line"
    say "{\"id\":$id,\"result\":{\"turnId\":\"$TURN\"}}"
    ;;
  turn/interrupt)
    log "interrupt"
    say "{\"id\":$id,\"result\":{}}"
    ;;
  "") ;;
  *) say "{\"id\":$id,\"error\":{\"code\":-32600,\"message\":\"the fake does not serve $method mid-turn\"}}" ;;
  esac
}

# Reads krowk's lines until one names `$1` (a method, or `answer` for the
# answer to server request `$2`); side requests are served meanwhile.
await() {
  local want="$1" srv="${2:-}" line
  while IFS= read -r line; do
    log "in $line"
    if [ "$want" = answer ]; then
      case "$line" in
      "{\"id\":\"$srv\""*)
        LAST="$line"
        return 0
        ;;
      esac
      side_request "$line"
      continue
    fi
    if [ "$(req_method "$line")" = "$want" ]; then
      AWAITED="$line"
      return 0
    fi
    side_request "$line"
  done
  exit 0
}

play_turn() {
  local n=0 turns=0 file="${FAKE_CODEX_SCENARIO:-}" line
  if [ -f "$HOME_DIR/fake-turns" ]; then turns="$(cat "$HOME_DIR/fake-turns")"; fi
  echo $((turns + 1)) >"$HOME_DIR/fake-turns"
  if [ -z "$file" ]; then
    say "$(fill '{"method":"item/started","params":{"item":{"type":"agentMessage","id":"msg-plain","text":""},"threadId":"{{THREAD}}","turnId":"{{TURN}}","startedAtMs":1}}')"
    say "$(fill '{"method":"item/completed","params":{"item":{"type":"agentMessage","id":"msg-plain","text":"done"},"threadId":"{{THREAD}}","turnId":"{{TURN}}","completedAtMs":2}}')"
    say "$(fill '{"method":"thread/tokenUsage/updated","params":{"threadId":"{{THREAD}}","turnId":"{{TURN}}","tokenUsage":{"last":{"inputTokens":10,"cachedInputTokens":0,"outputTokens":1,"reasoningOutputTokens":0,"totalTokens":11},"total":{"inputTokens":10,"cachedInputTokens":0,"outputTokens":1,"reasoningOutputTokens":0,"totalTokens":11}}}}')"
    say "$(fill '{"method":"turn/completed","params":{"threadId":"{{THREAD}}","turn":{"id":"{{TURN}}","items":[],"status":"completed","error":null}}}')"
    return
  fi
  while IFS= read -r line || [ -n "$line" ]; do
    if [ "$line" = "---" ]; then
      n=$((n + 1))
      continue
    fi
    [ "$n" = "$turns" ] || continue
    case "$line" in
    "") ;;
    "@ask "*)
      SRV=$((SRV + 1))
      local body="${line#@ask }"
      body="$(fill "$body")"
      say "{\"id\":\"srv-$SRV\",${body#\{}"
      await answer "srv-$SRV" <&3
      ;;
    "@tool-result "*)
      local item="${line#@tool-result }" text
      # krowk's answer is {"id":…,"result":{"contentItems":[{…,"text":"…"}],"success":…}}:
      # the text is what lies between its "text":" and the "}], that closes it.
      text="${LAST#*\"text\":\"}"
      text="${text%%\"\}\],\"success\"*}"
      # Built in a variable, not inside "$(…)": bash 3.2 mis-parses escaped
      # quotes nested in a command substitution inside double quotes.
      local done_line='{"method":"item/completed","params":{"item":{"type":"dynamicToolCall","id":"'"$item"'","namespace":"krowk","tool":"session_info","arguments":{},"status":"completed","success":true,"contentItems":[{"type":"inputText","text":"'"$text"'"}]},"threadId":"{{THREAD}}","turnId":"{{TURN}}","completedAtMs":3}}'
      say "$(fill "$done_line")"
      ;;
    "@await-interrupt")
      await turn/interrupt <&3
      log "interrupt"
      say "{\"id\":$(req_id "$AWAITED"),\"result\":{}}"
      ;;
    "@await-steer")
      await turn/steer <&3
      log "steer $AWAITED"
      say "{\"id\":$(req_id "$AWAITED"),\"result\":{\"turnId\":\"$TURN\"}}"
      ;;
    "@refuse-steer")
      await turn/steer <&3
      log "refused $AWAITED"
      say "{\"id\":$(req_id "$AWAITED"),\"error\":{\"code\":-32600,\"message\":\"no active turn to steer\"}}"
      ;;
    "@sleep "*) sleep "${line#@sleep }" ;;
    "@exit "*)
      log "exit ${line#@exit }"
      exit "${line#@exit }"
      ;;
    "@exit-once "*)
      if [ ! -f "$HOME_DIR/fake-exited" ]; then
        : >"$HOME_DIR/fake-exited"
        log "exit ${line#@exit-once }"
        exit "${line#@exit-once }"
      fi
      ;;
    "@grandchild")
      sleep 300 </dev/null >/dev/null 2>&1 &
      log "grandchild $!"
      ;;
    *) say "$(fill "$line")" ;;
    esac
  done <"$file"
}

# krowk's stdin, kept on fd 3 while a scenario file is read on stdin.
exec 3<&0
TURNS=0
while IFS= read -r line <&3; do
  log "in $line"
  id="$(req_id "$line")"
  method="$(req_method "$line")"
  case "$method" in
  initialize)
    say "{\"id\":$id,\"result\":{\"userAgent\":\"krowk/0.154.0 (fake)\",\"codexHome\":\"$HOME_DIR\",\"platformFamily\":\"unix\",\"platformOs\":\"linux\"}}"
    ;;
  account/read)
    say "{\"id\":$id,\"result\":$(account)}"
    ;;
  model/list)
    say "{\"id\":$id,\"result\":{\"data\":[{\"id\":\"gpt-5.5\",\"model\":\"gpt-5.5\",\"displayName\":\"GPT-5.5\",\"description\":\"\",\"hidden\":false,\"supportedReasoningEfforts\":[{\"reasoningEffort\":\"low\",\"description\":\"\"},{\"reasoningEffort\":\"medium\",\"description\":\"\"},{\"reasoningEffort\":\"high\",\"description\":\"\"},{\"reasoningEffort\":\"xhigh\",\"description\":\"\"}],\"defaultReasoningEffort\":\"medium\",\"inputModalities\":[\"text\"],\"supportsPersonality\":false,\"isDefault\":true}],\"nextCursor\":null}}"
    ;;
  config/read)
    log "config-read"
    mcp="${FAKE_CODEX_MCP:-}"
    [ -n "$mcp" ] || mcp='{}'
    say "{\"id\":$id,\"result\":{\"config\":{\"model\":\"gpt-5.5\",\"mcp_servers\":$mcp},\"origins\":{}}}"
    ;;
  hooks/list)
    hooks='[]'
    case "$ARGV" in
    *'hooks.PreToolUse='*__paste-guard*)
      trust=untrusted
      [ -f "$HOME_DIR/fake-hook-trusted" ] && trust=trusted
      hooks='[{"key":"/<session-flags>/config.toml:pre_tool_use:0:0","eventName":"preToolUse","handlerType":"command","command":"krowk __paste-guard","async":false,"matcher":"^Bash$","timeoutSec":600,"statusMessage":null,"additionalContextLimit":null,"sourcePath":"/<session-flags>/config.toml","source":"sessionFlags","pluginId":null,"displayOrder":0,"enabled":true,"isManaged":false,"currentHash":"sha256:fake-paste-guard","trustStatus":"'$trust'"}]'
      ;;
    esac
    say "{\"id\":$id,\"result\":{\"data\":[{\"cwd\":\"$CWD\",\"hooks\":$hooks,\"warnings\":[],\"errors\":[]}]}}"
    ;;
  config/value/write)
    log "config-write $line"
    : >"$HOME_DIR/fake-hook-trusted"
    say "{\"id\":$id,\"result\":{\"status\":\"ok\",\"version\":\"sha256:fake\",\"filePath\":\"$HOME_DIR/config.toml\",\"overriddenMetadata\":null}}"
    ;;
  thread/start | thread/resume)
    m="$(field "$line" model)"
    [ -n "$m" ] && MODEL="$m"
    c="$(field "$line" cwd)"
    [ -n "$c" ] && CWD="$c"
    if [ "$method" = thread/resume ]; then
      THREAD="$(field "$line" threadId)"
      log "resume $THREAD"
      # As Codex does: a thread is resumed from its rollout — the path it
      # is given, else the one under this home — or not at all.
      rollout="$(field "$line" path)"
      [ -n "$rollout" ] || rollout="$(rollout_path)"
      if [ "${FAKE_CODEX_RESUME:-}" = fail ] || [ ! -f "$rollout" ]; then
        log "resume-missing $rollout"
        say "{\"id\":$id,\"error\":{\"code\":-32600,\"message\":\"no rollout found for thread id $THREAD\"}}"
        continue
      fi
      log "resume-lines $(wc -l <"$rollout" | tr -d ' ') $rollout"
    fi
    say "{\"id\":$id,\"result\":$(thread_result "$(field "$line" sandbox)" "$(field "$line" approvalPolicy)" "$(field "$line" approvalsReviewer)")}"
    say "{\"method\":\"thread/started\",\"params\":{\"thread\":{\"id\":\"$THREAD\",\"sessionId\":\"$THREAD\",\"preview\":\"\",\"projectId\":null,\"ephemeral\":false,\"modelProvider\":\"openai\",\"createdAt\":1790344936,\"updatedAt\":1790344936,\"status\":{\"type\":\"idle\"},\"cwd\":\"$CWD\",\"cliVersion\":\"0.154.0\",\"source\":\"appServer\",\"turns\":[]}}}"
    ;;
  turn/start)
    TURNS=$((TURNS + 1))
    TURN="01a0d8df-e17f-7ed2-b3ff-6bfc4290$(printf '%04d' "$TURNS")"
    m="$(field "$line" model)"
    [ -n "$m" ] && MODEL="$m"
    # What the thread was sent, kept in its rollout as Codex keeps it.
    printf '%s\n' "$line" >>"$(rollout_path)"
    say "{\"id\":$id,\"result\":{\"turn\":{\"id\":\"$TURN\",\"items\":[],\"status\":\"inProgress\",\"error\":null}}}"
    say "{\"method\":\"turn/started\",\"params\":{\"threadId\":\"$THREAD\",\"turn\":{\"id\":\"$TURN\",\"items\":[],\"status\":\"inProgress\",\"error\":null}}}"
    play_turn
    ;;
  turn/steer)
    say "{\"id\":$id,\"error\":{\"code\":-32600,\"message\":\"no active turn to steer\"}}"
    ;;
  turn/interrupt)
    say "{\"id\":$id,\"result\":{}}"
    ;;
  "") ;;
  *)
    say "{\"id\":$id,\"error\":{\"code\":-32601,\"message\":\"the fake does not serve $method\"}}"
    ;;
  esac
done
exit 0
