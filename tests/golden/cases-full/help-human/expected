$ krowk help flags --format human
stdout:
krowk help flags — The flags every command takes

GLOBAL FLAGS
  --workspace <string>  Use this workspace's stored key for this one command —
                        outranks KROWK_WORKSPACE and every config file
  --dev                 Talk to a local registry at http://localhost:8787/v1
  --format <string>     human | json | markdown | url (default: human on a TTY,
                        json when piped). markdown and url describe an upload;
                        other commands fall back to json
  --json                Shorthand for --format json
  --quiet               Raw JSON, no envelope
  --jq <string>         Filter the JSON with a jq expression — built in, no jq
                        binary needed. Implies --format json, and reads the bare
                        record under --quiet
  --help, -h            Show the help
  --version, -v         Print the version

AGENT FLAGS (krowk, krowk -p)
  --print, -p                 Run the prompt given as the arguments (or on
                              stdin) headless: krowk's own agent answers it,
                              then exits
  --output-format <string> (default text)
                              With -p: text (the answer), json (the result
                              event) or stream-json (every event, one per line)
  --model <string>            With -p: the model, as <instance>/<model> or a
                              model id on the anthropic instance, e.g.
                              claude-opus-5-5, claude:work/sonnet to run Claude
                              Code, or codex:team/gpt-5.5 to run Codex; with
                              --resume, the session moves there
  --resume <string>           With -p: continue this krowk session — the
                              sessionId a result names, or its krowk.db id
  --permission-mode <string> (default default)
                              With -p and the agent: default, acceptEdits, plan
                              or bypassPermissions, as in Claude Code, or
                              unhinged, which asks about nothing: no krowk deny
                              rule, ask rule or protected directory holds.
                              Without it, the settings' permissions.defaultMode;
                              in every other mode a deny rule holds
  --toolset <string>          With -p: the tools' preset — claude (str_replace),
                              gpt (apply_patch) or grok (search_replace). The
                              model's family picks one when absent
  --effort <string>           With -p: how hard the model thinks — none,
                              minimal, low, medium, high, xhigh or max, mapped
                              onto the nearest the model takes. The instance's,
                              else the provider's default, when absent
  --max-usd <string>          With -p, and in the TUI: stop the session before
                              the model call that would take it, with its
                              subagents, past this many dollars — metered,
                              priced from models.dev. Exits 4, like `krowk
                              sessions budget`
  --max-tokens <string>       With -p, and in the TUI: stop the session before
                              the model call that would take its generated
                              tokens (output and reasoning, subagents included)
                              past this many. Exits 4
  --trust                     With -p: let a backend (Claude Code, Codex) run in
                              a repository not yet trusted — it runs the
                              repository's hooks and MCP servers without asking.
                              Without it, -p refuses unless a person at the
                              terminal says yes
  --daemon                    With -p: run the turn in the host daemon (started
                              when none runs) instead of this process, so it
                              goes on if this process ends — `krowk host attach
                              <session>` follows it
exit: 0

