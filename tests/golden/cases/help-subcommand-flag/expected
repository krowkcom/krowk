$ krowk sessions import --help
stdout:
{
  "name": "sessions import",
  "usage": "krowk sessions import --from <provider|all> [--dry-run] [--limit N]",
  "summary": "Import this machine's agent transcripts",
  "flags": [
    {
      "name": "from",
      "type": "string",
      "default": "",
      "usage": "Which transcripts to read: claude, cursor, opencode, ledger (provider usage ledgers), or all. Required"
    },
    {
      "name": "dry-run",
      "type": "bool",
      "default": "false",
      "usage": "Count what would be imported and write nothing"
    },
    {
      "name": "limit",
      "type": "int",
      "default": "0",
      "usage": "Read at most this many transcripts per source (0 is all)"
    }
  ]
}
exit: 0

