$ krowk config show
stdout:
{
  "ok": true,
  "data": {
    "global_path": ".krowk/config.json",
    "repo_path": "<scratch>/work/.krowk/config.json"
  },
  "summary": "no configuration set — uploads use the stored default key",
  "breadcrumbs": [
    {
      "action": "set the workspace",
      "cmd": "krowk config set workspace <workspace>",
      "description": "pins which workspace commands in this repository use — --global sets the machine-wide fallback instead"
    }
  ]
}
exit: 0

$ krowk config set workspace ws_x --global
stdout:
{
  "ok": true,
  "data": {
    "key": "workspace",
    "value": "ws_x",
    "path": ".krowk/config.json"
  },
  "summary": "workspace = ws_x in .krowk/config.json",
  "breadcrumbs": [
    {
      "action": "check the effective configuration",
      "cmd": "krowk config show",
      "description": "reports what actually resolves here, which layer wins, and why"
    }
  ]
}
exit: 0

