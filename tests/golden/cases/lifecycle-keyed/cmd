# One artifact and one run through every command that takes a slug: show,
# attach, list with a cursor, finish, delete, and the tombstone after.
@registry
@env KROWK_TOKEN=krowk_sk_test
@file a.txt hello
@file b.txt world
krowk runs start --title "the work"
@let RUN .data.slug
krowk push a.txt
@let ART .data.artifacts[0].slug
krowk artifacts show {ART}
krowk artifacts show {ART} --format human
krowk artifacts show {ART} --format markdown
krowk artifacts attach {ART} --run {RUN}
krowk artifacts attach {ART} --run {RUN}
krowk runs show {RUN}
krowk runs show {RUN} --format human
krowk push b.txt --run {RUN}
krowk push b.txt --run {registry}/r/{RUN}
krowk runs list --limit 1
@let RUNNEXT .data.next
krowk runs list --limit 1 --before {RUNNEXT}
krowk artifacts list --limit 1
@let NEXT .data.next
krowk artifacts list --limit 1 --before {NEXT}
krowk artifacts list --run {RUN}
krowk runs finish {RUN}
krowk runs finish {RUN}
krowk runs show {RUN} --format human
krowk artifacts delete {ART}
krowk artifacts delete {ART}
krowk artifacts show {ART}
krowk artifacts attach
krowk artifacts attach {ART}
