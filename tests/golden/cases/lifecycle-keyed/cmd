# One artifact and one run through every command that takes a slug: show,
# attach, list with a cursor, finish, delete, and the tombstone after.
@registry
@env GRUNTAS_TOKEN=krowk_sk_test
@file a.txt hello
@file b.txt world
gruntas runs start --title "the work"
@let RUN .data.slug
gruntas push a.txt
@let ART .data.artifacts[0].slug
gruntas artifacts show {ART}
gruntas artifacts show {ART} --format human
gruntas artifacts show {ART} --format markdown
gruntas artifacts attach {ART} --run {RUN}
gruntas artifacts attach {ART} --run {RUN}
gruntas runs show {RUN}
gruntas runs show {RUN} --format human
gruntas push b.txt --run {RUN}
gruntas push b.txt --run {registry}/r/{RUN}
gruntas runs list --limit 1
@let RUNNEXT .data.next
gruntas runs list --limit 1 --before {RUNNEXT}
gruntas artifacts list --limit 1
@let NEXT .data.next
gruntas artifacts list --limit 1 --before {NEXT}
gruntas artifacts list --run {RUN}
gruntas runs finish {RUN}
gruntas runs finish {RUN}
gruntas runs show {RUN} --format human
gruntas artifacts delete {ART}
gruntas artifacts delete {ART}
gruntas artifacts show {ART}
gruntas artifacts attach
gruntas artifacts attach {ART}
