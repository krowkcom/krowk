$ krowk help push
stdout:
{
  "name": "push",
  "usage": "krowk push <file...> [flags]",
  "summary": "Upload files, get a link for each",
  "args": [
    {
      "name": "file",
      "summary": "Path to upload",
      "required": true,
      "repeated": true
    }
  ],
  "flags": [
    {
      "name": "run",
      "type": "string",
      "default": "",
      "usage": "Attach to an existing run instead of opening one. Its slug, or a link carrying it"
    },
    {
      "name": "caption",
      "type": "string",
      "default": "",
      "usage": "What this file shows, recorded on the artifact as `krowk.caption` and used wherever it is pasted. Repeat to caption several files, in the order they are given",
      "repeatable": true
    },
    {
      "name": "destination",
      "type": "string",
      "default": "",
      "usage": "Print what this tool wants pasted into it: the krowk block for github, linear and the like, the bare link for the ones that unfurl it themselves, like slack. A tool krowk has not been told about gets the block"
    },
    {
      "name": "private",
      "type": "bool",
      "default": "false",
      "usage": "Upload where only this workspace can read it. The image still embeds — the byte URL is the capability — but the card opens only for a signed-in member, reads as not found to everyone else, and unfurls nowhere. Needs an API key"
    },
    {
      "name": "pull-request",
      "type": "string",
      "default": "",
      "usage": "Pull request the work belongs to"
    },
    {
      "name": "link",
      "type": "string",
      "default": "",
      "usage": "Link this work is about — the issue, the spec, the discussion. An absolute http(s) URL, repeatable up to 20, recorded on the run as `krowk.links`; label or classify each with --link-title and --link-rel",
      "repeatable": true
    },
    {
      "name": "link-title",
      "type": "string",
      "default": "",
      "usage": "What to call the --link before it, instead of its URL. One line",
      "repeatable": true
    },
    {
      "name": "link-rel",
      "type": "string",
      "default": "",
      "usage": "What the --link before it is: tracks, fixes, spec, discussion, source, supersedes — or a word of your own",
      "repeatable": true
    },
    {
      "name": "reference",
      "type": "string",
      "default": "",
      "usage": "Related identifier that is not a URL, e.g. a ticket key — repeat for more than one. A URL is a --link",
      "repeatable": true
    },
    {
      "name": "session",
      "type": "string",
      "default": "",
      "usage": "Override the detected agent session ID"
    },
    {
      "name": "title",
      "type": "string",
      "default": "",
      "usage": "Title for the work this push belongs to, recorded on the run. What a pasted link says is the artifact's --caption"
    },
    {
      "name": "repo",
      "type": "string",
      "default": "",
      "usage": "Override the detected repository"
    },
    {
      "name": "commit",
      "type": "string",
      "default": "",
      "usage": "Override the detected commit"
    },
    {
      "name": "agent",
      "type": "string",
      "default": "",
      "usage": "Override the detected agent"
    },
    {
      "name": "metadata",
      "type": "string",
      "default": "",
      "usage": "Extra key=value metadata, repeatable: on push it lands on each artifact, on `runs start` on the run. Your value wins over a detected one. Metadata is public",
      "repeatable": true
    }
  ]
}
exit: 0

