# --jq over a record that needs no registry: the help catalog. What gojq
# does is the contract — formats, key order, numbers JSON cannot spell.
gruntas help --jq '.name'
gruntas help --jq '[.commands[].name] | @csv'
gruntas help --jq '[.commands[].name] | @tsv'
gruntas help --jq '[.global_flags[] | [.name, .type]] | .[] | @csv'
gruntas help --jq '.environment[0] | to_entries[0].key'
gruntas help --jq '.environment[0] | keys'
gruntas help --jq '.environment[0] | [.[] | type]'
gruntas help --jq '[.environment[0] | paths]'
gruntas help --jq '.environment[0] | tojson'
gruntas help --jq '[.commands[0].args[0] | tostream]'
gruntas help --jq '[nan, infinite, -infinite, 1.5e300 * 1e10]'
gruntas help --jq '.commands | length'
gruntas help --jq '[.commands[] | select(.subcommands) | .name]'
gruntas help --jq '.commands[0].name | ascii_upcase'
gruntas help --jq '.commands[0].name | test("pu")'
gruntas help --jq '.name | @base64'
gruntas help --jq '[limit(2; .commands[].name)]'
gruntas help --jq '.commands[0] | has("usage")'
gruntas help --jq '.name | tonumber'
gruntas help push --jq '.flags | map(.name) | join(",")'
gruntas help --jq 'halt_error'
gruntas help --jq '(.commands | length) / 2'
gruntas help --jq '[10/2, 5*1.0, 1e17, 0.5, 1e21, 1e-7]'
gruntas help --jq '"\([.commands[0].name, 1] | @csv)"'
gruntas help --jq '.commands[0] | @csv "row: \([.name, .usage])"'
