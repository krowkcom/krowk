# krowk_push never publishes anything in krowk's home, wherever KROWK_HOME
# puts it and however the path reaches it, nor a directory named .krowk; a
# root inside the home is refused.
@registry
@env KROWK_HOME={work}/state
@file state/config.json {}
@file .krowk/config.json {}
@file ok.txt fine
@sh ln -s state alias
