# Two stored keys; the default moves with `use`, and --workspace and
# GRUNTAS_WORKSPACE pick one per command.
@registry
gruntas auth login --token krowk_sk_first
@let WS1 .data.workspace
gruntas auth login --token krowk_sk_second
@let WS2 .data.workspace
gruntas workspaces
gruntas workspaces use {WS1}
gruntas workspaces
@cat {home}/.gruntas/credentials.json
gruntas auth verify
gruntas auth verify --workspace {WS2}
@env GRUNTAS_WORKSPACE={WS2}
gruntas auth verify
gruntas auth verify --workspace {WS1}
gruntas auth verify --workspace ws_unknown000000000000000
@unenv GRUNTAS_WORKSPACE
@sh mkdir -p .git
gruntas config set workspace {WS2}
gruntas auth verify
@file a.txt hello
gruntas push a.txt --jq '.data.artifacts[0].file_url'
gruntas workspaces --format human
@tty gruntas workspaces
