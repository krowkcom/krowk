{
  "name": "@gruntas/pi",
  "version": "0.0.0-unpublished",
  "description": "Gruntas for pi: runs the pi extension the installed gruntas carries, which registers pi sessions with the gruntas daemon and runs pi's Claude turns on your gruntas accounts through Claude Code.",
  "keywords": [
    "pi-package",
    "gruntas",
    "pi",
    "coding-agent"
  ],
  "homepage": "https://gruntas.com",
  "bugs": "https://github.com/gruntas/gruntas/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gruntas/gruntas.git",
    "directory": "npm/pi"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "src/loader.ts"
  ],
  "pi": {
    "extensions": [
      "./src/loader.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=22",
    "pi": ">=1.6.0 <2"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.332",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "esbuild": "0.28.2"
  }
}
