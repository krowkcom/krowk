{
  "name": "@gruntas/pi",
  "version": "0.0.0-unpublished",
  "description": "Gruntas for pi: registers pi sessions with the gruntas daemon, through the same `gruntas hook` the Claude Code and Codex plugins run, and runs pi's Claude turns on your gruntas accounts through Claude Code.",
  "keywords": [
    "pi-package",
    "gruntas",
    "pi",
    "coding-agent"
  ],
  "homepage": "https://gruntas.com",
  "bugs": "https://github.com/gruntas/gruntas/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gruntas/gruntas.git",
    "directory": "npm/pi"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "src/gruntas.ts",
    "src/hook.ts",
    "src/claude",
    "THIRD-PARTY-NOTICES",
    "skills/gruntas/SKILL.md"
  ],
  "pi": {
    "extensions": [
      "./src/gruntas.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.332",
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=22",
    "pi": ">=1.6.0 <2"
  }
}
